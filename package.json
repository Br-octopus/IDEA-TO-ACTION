{
  "name": "forward-step",
  "version": "0.1.0",
  "private": true,
  "description": "向前一步：想法推进与提示词助手",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "test": "node --test",
    "check": "node --check server.js && node --check server/model-client.js && node --check server/search-client.js && node --check electron/settings-store.js && node --check electron/main.js && node --check electron/preload.js && node --check prototype/knowledge-search.js && node --check prototype/app.js",
    "dist:win": "electron-builder --win nsis portable"
  },
  "engines": { "node": ">=18" },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.forwardstep.app",
    "productName": "向前一步",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "prototype/**/*",
      "server/**/*",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "向前一步",
      "uninstallDisplayName": "向前一步",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "ForwardStep-${version}-setup.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "ForwardStep-${version}-portable.${ext}"
    }
  }
}
